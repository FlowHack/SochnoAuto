<button class="carousel-control-prev" onclick="replaceSpecialOffers(this)"
        data-page="{{ prev_page }}" {{#if hide_prev }}style="visibility:hidden"{{/if}}>
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Предыдущий</span>
</button>

<button class="carousel-control-next" onclick="replaceSpecialOffers(this)"
        data-page="{{ next_page }}" {{#if hide_next }}style="visibility:hidden"{{/if}}>
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Следующий</span>
</button>